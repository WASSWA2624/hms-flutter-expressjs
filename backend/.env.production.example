# HMS Backend - production environment template (cPanel)
# Copy to .env.production, fill in the real values, then upload the result
# to the backend's directory on cPanel. Never commit .env.production itself.
# See "Deploying to cPanel" in README.md.

NODE_ENV="production"

# cPanel typically prefixes both the database name and username with your
# cPanel account name, e.g. mysql://cpaneluser_dbuser:PASSWORD@localhost:3306/cpaneluser_dbname
DATABASE_URL="mysql://cpaneluser_dbuser:CHANGE_ME@localhost:3306/cpaneluser_dbname"

# Generate a dedicated secret, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

CORS_ORIGINS="https://www.example.com,https://api.example.com"

PORT="3000"
HOST="127.0.0.1"
TRUST_PROXY="1"
HANDLE_SIGINT="true"
ALLOW_PRIVATE_NETWORK_ORIGINS="false"

APP_PUBLIC_URL="https://www.example.com"
APP_DISPLAY_NAME="Hospital Management System"
APP_SHORT_NAME="HMS"

SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME="Hospital Management System"
SMTP_REPLY_TO=""
SMTP_NO_REPLY_ADDRESS=""
ALLOW_PLAINTEXT_PASSWORD_EMAIL="false"

SUBSCRIPTION_EXPIRING_SOON_DAYS="14"
TRIAL_DURATION_DAYS="90"
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PHONE=""
PLATFORM_BANK_ACCOUNT_NAME=""
PLATFORM_BANK_NAME=""
PLATFORM_BANK_BRANCH=""
PLATFORM_BANK_ACCOUNT_NUMBER=""
PLATFORM_BANK_SWIFT_CODE=""
PLATFORM_BANK_IBAN=""
PLATFORM_WHATSAPP=""
PLATFORM_MOBILE_MONEY_NAME=""
PLATFORM_MOBILE_MONEY_MTN=""
PLATFORM_MOBILE_MONEY_AIRTEL=""

# Generate a dedicated secret, distinct from JWT_SECRET and from development.
CSRF_SECRET=""
ENCRYPTION_KEY=""

STORAGE_PROVIDER="local"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET=""

WS_MAX_CONNECTIONS="1000"
WS_HEARTBEAT_INTERVAL="30000"
WS_HEARTBEAT_TIMEOUT="60000"

PRISMA_POOL_CONNECTION_LIMIT="10"
PRISMA_POOL_CONNECT_TIMEOUT_MS="5000"
PRISMA_POOL_ACQUIRE_TIMEOUT_MS="5000"
PRISMA_MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL="false"

SEED_RECORD_COUNT="1000"
SEED_RANDOM_SEED="20260217"

PACS_DICOMWEB_BASE_URL=""
PACS_AUTH_MODE="none"
PACS_USERNAME=""
PACS_PASSWORD=""
PACS_BEARER_TOKEN=""
PACS_TIMEOUT_MS="10000"

# Requires an Ollama instance reachable from the cPanel server; set
# AI_ENABLED="false" if none is available in production.
AI_ENABLED="false"
AI_PROVIDER="ollama"
AI_BASE_URL="http://127.0.0.1:11434"
AI_MODEL="gemma3:4b"
AI_TIMEOUT_MS="8000"
AI_CLINICAL_NOTE_FORMAT_TIMEOUT_MS="90000"
AI_DRUG_PACK_EXTRACT_TIMEOUT_MS="90000"
AI_MAX_INPUT_CHARS="4000"
AI_TEMPERATURE="0"

FEATURE_CLINICAL_WORKBENCH_V2="true"
FEATURE_CLINICAL_ALERT_AUTO_RULES="true"
FEATURE_FOLLOW_UP_REMINDER_DISPATCH="true"
FEATURE_IPD_WORKBENCH_V1="false"
FEATURE_BILLING_WORKSPACE_V1="true"
PHARMACY_WORKSPACE_V1="false"
FEATURE_COMMUNICATIONS_WORKSPACE_V1="true"
FEATURE_SUBSCRIPTIONS_WORKSPACE_V1="true"
FEATURE_DASHBOARD_WORKSPACE_V1="true"
FEATURE_SETTINGS_WORKSPACE_V1="true"
FEATURE_HR_WORKSPACE_V1="true"
FEATURE_HOUSEKEEPING_WORKSPACE_V1="true"
FEATURE_BIOMEDICAL_WORKSPACE_V1="true"
FEATURE_REPORTS_WORKSPACE_V1="true"
RADIOLOGY_ATTESTATION_V2="false"
