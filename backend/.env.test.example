# HMS Backend - safe local test environment
# Copy to .env.test. Do not use production credentials.

NODE_ENV="test"
DATABASE_URL="mysql://hms_test:hms_test@127.0.0.1:3306/hms_test"
JWT_SECRET="test-jwt-secret-key-minimum-32-characters-long"
CORS_ORIGINS="http://127.0.0.1:8081,http://localhost:8081"
PORT="3001"
HOST="127.0.0.1"
TRUST_PROXY="false"
HANDLE_SIGINT="false"
ALLOW_PRIVATE_NETWORK_ORIGINS="false"
APP_PUBLIC_URL="http://127.0.0.1:8081"
APP_DISPLAY_NAME="Hospital Management System Test"
APP_SHORT_NAME="HMS Test"
JWT_ACCESS_TOKEN_EXPIRATION="15m"
JWT_REFRESH_TOKEN_EXPIRATION="7d"
AUTH_SESSION_TTL_DAYS="7"
STORAGE_PROVIDER="local"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME="Hospital Management System Test"
SMTP_REPLY_TO=""
SMTP_NO_REPLY_ADDRESS=""
ALLOW_PLAINTEXT_PASSWORD_EMAIL="false"
SUBSCRIPTION_EXPIRING_SOON_DAYS="14"
TRIAL_DURATION_DAYS="90"
PLATFORM_ADMIN_EMAIL="billing-test@example.com"
PLATFORM_ADMIN_PHONE="+256 700 000 000"
PLATFORM_BANK_ACCOUNT_NAME="HOSSPI HMS Test Collections"
PLATFORM_BANK_NAME="Test Bank Uganda"
PLATFORM_BANK_BRANCH="Test Branch"
PLATFORM_BANK_ACCOUNT_NUMBER="0000000000000"
PLATFORM_BANK_SWIFT_CODE="TESTUGKA"
PLATFORM_BANK_IBAN=""
CSRF_SECRET="test-csrf-secret-key-minimum-32-characters-long"
ENCRYPTION_KEY=""
WS_MAX_CONNECTIONS="50"
WS_HEARTBEAT_INTERVAL="30000"
WS_HEARTBEAT_TIMEOUT="60000"
PRISMA_POOL_CONNECTION_LIMIT="2"
PRISMA_POOL_CONNECT_TIMEOUT_MS="5000"
PRISMA_POOL_ACQUIRE_TIMEOUT_MS="5000"
PRISMA_MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL="true"
SEED_RECORD_COUNT="5"
SEED_RANDOM_SEED="20260504"
PACS_DICOMWEB_BASE_URL=""
PACS_AUTH_MODE="none"
PACS_USERNAME=""
PACS_PASSWORD=""
PACS_BEARER_TOKEN=""
PACS_TIMEOUT_MS="5000"
AI_ENABLED="true"
AI_PROVIDER="ollama"
AI_BASE_URL="http://127.0.0.1:11434"
AI_MODEL="llama3.2:3b"
AI_TIMEOUT_MS="8000"
AI_MAX_INPUT_CHARS="4000"
AI_TEMPERATURE="0"
OTEL_ENABLED="false"
OTEL_SERVICE_NAME="hms-backend-test"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_METRIC_EXPORT_INTERVAL_MS="60000"
PHARMACY_WORKSPACE_V1="false"
RADIOLOGY_ATTESTATION_V2="false"
ALLOW_REMOTE_TEST_DATABASE="false"
