# ============================================
# HOSSPI site - production environment
# ============================================
# Values here are non-secret and safe to commit. They mirror the HMS platform's
# production settings (see the HMS backend .env.production) so the site and the
# application send mail from the same account and reply to the same inbox.
#
# SMTP_USER and SMTP_PASS are deliberately NOT in this file. Put them in
# .env.production.local (git-ignored) for local builds, and in the host's
# environment variables for the deployed site.
#
# NEXT_PUBLIC_* values are inlined at build time, so this file must be correct
# BEFORE running `next build`. Note that .env.local outranks this file in
# Next.js' load order, so deployment builds pass NEXT_PUBLIC_APP_URL explicitly.

# ============================================
# Public site
# ============================================
# The canonical host is www: the apex redirects there, and every canonical
# link, sitemap entry and share card is baked from this value.
NEXT_PUBLIC_APP_URL="https://www.hosspi.com"

NEXT_PUBLIC_CONTACT_EMAIL="wasswawilson0002@gmail.com"
NEXT_PUBLIC_SUPPORT_EMAIL="wasswawilson0002@gmail.com"

# ============================================
# Email / SMTP - contact form delivery
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"

# Gmail requires the From address to be the authenticated account or one of its
# verified aliases, so this matches SMTP_USER rather than the reply-to inbox.
SMTP_FROM="HOSSPI <wasswawilson0002@gmail.com>"

# Acknowledge the sender after a successful submission.
SEND_CONFIRMATION_EMAIL="true"

# ============================================
# Feature flags
# ============================================
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
NEXT_PUBLIC_MAINTENANCE_MODE="false"
