# Copy to .env.local for development, or .env.production.local for a
# production build. Anything with a credential in it must stay git-ignored.

# ============================================
# Public site
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL="wasswawilson0002@gmail.com"
NEXT_PUBLIC_SUPPORT_EMAIL="wasswawilson0002@gmail.com"

# ============================================
# Email / SMTP - contact form delivery
# ============================================
# Without these the form still succeeds; submissions are logged instead of sent.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HOSSPI <you@example.com>"
SEND_CONFIRMATION_EMAIL="true"

# ============================================
# Feature flags
# ============================================
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
NEXT_PUBLIC_MAINTENANCE_MODE="false"
